# 在 backend/ 目录运行本地 FastAPI 时的示例（请复制为 .env 并修改）
DATABASE_URL=postgresql+asyncpg://zhimian:local-dev-only@127.0.0.1:5432/zhimian
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# 模型密钥仅存放于服务端本地环境，勿提交。
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=60

# M3 单操作总尝试次数（含首次）、输出 token 上限、单次总时长上限。
MODEL_AI_MAX_ATTEMPTS=3
MODEL_AI_MAX_OUTPUT_TOKENS=1024
MODEL_AI_MAX_DURATION_SECONDS=120
