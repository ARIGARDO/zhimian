# 仅本机开发。请在公开部署前修改密码、增加 HTTPS 与入口访问控制。
POSTGRES_PASSWORD=local-dev-only

# 模型密钥仅存放于服务端本地环境，勿提交。
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=60

# M3 单操作总尝试次数（含首次）、输出 token 上限、单次总时长上限。
MODEL_AI_MAX_ATTEMPTS=3
MODEL_AI_MAX_OUTPUT_TOKENS=1024
MODEL_AI_MAX_DURATION_SECONDS=120
